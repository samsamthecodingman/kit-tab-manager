{
  "manifest_version": 2,
  "name": "Tab Bridge",
  "version": "0.3.0",
  "description": "Lets Claude Code list, group, move, close and read your Firefox tabs through a local bridge. It never clicks, types or submits anything.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-bridge@samroberts.local",
      "strict_min_version": "139.0"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "theme",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "mascot.js",
      "background.js",
      "actions.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Tab Bridge",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
